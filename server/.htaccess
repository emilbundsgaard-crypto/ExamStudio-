# Exam Studio on Apache (Simply.com webhotel)
# Own rewrite context so rules of the main site (e.g. clouterx.com) do not catch these files.
RewriteEngine On
Options -Indexes
DirectoryIndex index.html

# The course databases/workbooks are stored gzip-compressed and inflated in the browser:
# serve them as plain binary files, not with Content-Encoding.
<IfModule mod_mime.c>
  RemoveEncoding .gz
  AddType application/octet-stream .gz
  AddType application/wasm .wasm
  AddType text/javascript .js .mjs
</IfModule>
<IfModule mod_deflate.c>
  SetEnvIfNoCase Request_URI "\.gz$" no-gzip dont-vary
  SetEnvIfNoCase Request_URI "\.gz\.[0-9]+$" no-gzip dont-vary
  # the GridCraft spreadsheet engine (19 MB WebAssembly) compresses to a fraction
  AddOutputFilterByType DEFLATE application/wasm text/javascript application/javascript text/css text/html application/json
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(gz|wasm|js|css)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
