# Exam Studio – AI tutor settings. Copy to api/.env on the server and paste your key.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=PASTE_YOUR_KEY_HERE

# Model name exactly as Google lists it (check https://ai.google.dev/gemini-api/docs/models)
GEMINI_MODEL=gemini-3.8-flash

# How long one attempt may take before it counts as failed (seconds)
GEMINI_TIMEOUT_SECONDS=25

# Abuse limits – the key is yours, so cap what the public page can spend
MAX_REQUESTS_PER_IP_PER_HOUR=120
MAX_REQUESTS_PER_DAY=3000
